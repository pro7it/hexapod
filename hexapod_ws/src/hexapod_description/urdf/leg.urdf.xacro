<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_leg" params="side prefix x_pos y_pos z_pos yaw_rot">

    <link name="${prefix}_coxa_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-coxa.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.02964 0.00014 0.00625" rpy="0 0 0"/>
        <mass value="0.0771"/>
        <inertia ixx="1.617e-05" ixy="4.643e-08" ixz="6.122e-07" iyy="1.852e-05" iyz="-6.164e-08" izz="1.885e-05"/>
      </inertial>

    </link>

    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_coxa_link"/>
      <origin xyz="${x_pos} ${y_pos} ${z_pos}" rpy="0 0 ${yaw_rot}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="3.4" velocity="5.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_femur_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-femur.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 ${0.01 if side == 'left' else -0.01} 0"
                rpy="-1.57 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.06445 -0.00082 -0.00021" rpy="0 0 0"/>
        <mass value="0.0814"/>
        <inertia ixx="1.867e-05" ixy="-1.515e-06" ixz="-4.656e-07" iyy="2.912e-05" iyz="-7.096e-08" izz="4.288e-05"/>
      </inertial>

    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/>
      <child link="${prefix}_femur_link"/>
      <origin xyz="0.04 0 0.005" rpy="0 -0.78 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="3.4" velocity="5.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_tibia_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-tibia.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.05 -0.005 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.02796 0.00030 -0.03451" rpy="0 0 0"/>
        <mass value="0.0112"/>
        <inertia ixx="1.178e-05" ixy="1.476e-07" ixz="5.850e-06" iyy="1.578e-05" iyz="-2.169e-07" izz="4.209e-06"/>
      </inertial>

    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/>
      <child link="${prefix}_tibia_link"/>
      <origin xyz="0.08 0 0" rpy="0 0.078 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="3.4" velocity="5.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_shield_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/shield.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.04 0.005 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.02928 0.00052 -0.04358" rpy="0 0 0"/>
        <mass value="0.0098"/>
        <inertia ixx="1.094e-05" ixy="-6.245e-10" ixz="2.948e-06" iyy="1.025e-05" iyz="-6.117e-09" izz="3.014e-06"/>
      </inertial>

    </link>

    <joint name="${prefix}_shield_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child link="${prefix}_shield_link"/>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_micro_switch_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/micro-switch-tip.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.00621 -0.00001 0.02072" rpy="0 0 0"/>
        <mass value="0.0041"/>
        <inertia ixx="1.977e-07" ixy="2.657e-11" ixz="-4.968e-08" iyy="2.338e-07" iyz="5.395e-11" izz="1.167e-07"/>
      </inertial>

    </link>

    <joint name="${prefix}_micro_switch_tip_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child link="${prefix}_micro_switch_tip_link"/>
      <origin xyz="0.04 0 -0.13" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/tip.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      
      <inertial>
        <origin xyz="0.00000 -0.00000 -0.00309" rpy="0 0 0"/>
        <mass value="0.0018"/>
        <inertia ixx="1.069e-08" ixy="6.542e-14" ixz="-2.181e-12" iyy="1.069e-08" iyz="3.638e-12" izz="2.687e-09"/>
      </inertial>

    </link>

    <joint name="${prefix}_tip_joint" type="fixed">
      <parent link="${prefix}_micro_switch_tip_link"/>
      <child link="${prefix}_tip_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_tip_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
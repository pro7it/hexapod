<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_leg" params="side prefix x_pos y_pos z_pos yaw_rot">
    
    <link name="${prefix}_coxa_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-coxa.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-coxa-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia
          ixx="0.0002" ixy="0.0" ixz="0.0"
          iyy="0.0028" iyz="0.0"
          izz="0.0028"/>
      </inertial>
    </link>

    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_coxa_link"/>
      <origin xyz="${x_pos} ${y_pos} ${z_pos}" rpy="0 0 ${yaw_rot}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="100.0" velocity="3.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_femur_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-femur.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 ${0.1 if side == 'left' else -0.1} 0" rpy="-1.57 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-femur-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 ${0.1 if side == 'left' else -0.1} 0" rpy="-1.57 0 0"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia
          ixx="0.0003" ixy="0.0" ixz="0.0"
          iyy="0.016" iyz="0.0"
          izz="0.016"/>
      </inertial>
    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/>
      <child link="${prefix}_femur_link"/>
      <origin xyz="0.4 0 0.05" rpy="0 -0.78 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100.0" velocity="3.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_tibia_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-tibia.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.5 -0.05 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-tibia-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.5 -0.05 0" rpy="0 0 3.14"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.011" iyz="0.0"
          izz="0.011"/>
      </inertial>
    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/>
      <child link="${prefix}_tibia_link"/>
      <origin xyz="0.8 0 0" rpy="0 0.78 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100.0" velocity="3.0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <link name="${prefix}_shield_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/shield.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.4 0.05 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/shield-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.4 0.05 0" rpy="0 0 3.14"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_shield_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child link="${prefix}_shield_link"/>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_micro_switch_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/micro-switch-tip.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/micro-switch-tip-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02"/>
        <inertia
          ixx="0.00002" ixy="0.0" ixz="0.0"
          iyy="0.00002" iyz="0.0"
          izz="0.00002"/>
      </inertial>
    </link>

    <joint name="${prefix}_micro_switch_tip_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child link="${prefix}_micro_switch_tip_link"/>
      <origin xyz="0.4 0 -1.3" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_tip_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/tip.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/tip-collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_tip_joint" type="fixed">
      <parent link="${prefix}_micro_switch_tip_link"/>
      <child link="${prefix}_tip_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
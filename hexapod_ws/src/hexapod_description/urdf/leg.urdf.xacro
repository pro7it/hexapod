<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_leg" params="side prefix x_pos y_pos yaw_rot">
    
    <link name="${prefix}_coxa_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-coxa.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-coxa.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_coxa_link"/>
      <origin xyz="${x_pos} ${y_pos} 0" rpy="0 0 ${yaw_rot}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="2.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}_femur_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-femur.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-femur.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/>
      <child link="${prefix}_femur_link"/>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="2.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}_tibia_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-tibia.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/${side}-tibia.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/>
      <child link="${prefix}_tibia_link"/>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="2.0" velocity="1.0"/>
    </joint>

  </xacro:macro>

</robot>
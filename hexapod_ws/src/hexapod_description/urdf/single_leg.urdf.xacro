<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="single_leg_test">

  <!-- Тільки порожній базовий лінк -->
  <link name="base_link"/>

  <!-- Підключаємо макрос ноги -->
  <xacro:include filename="$(find hexapod_description)/urdf/leg.urdf.xacro"/>

  <!-- Викликаємо одну ногу -->
  <xacro:hexapod_leg side="left" prefix="l1" x_pos="-0.6" y_pos="0.8" z_pos="0.0" yaw_rot="2.35"/>
  <xacro:hexapod_leg side="right" prefix="r1" x_pos="0.6" y_pos="0.8" z_pos="0.0" yaw_rot="0.78"/>

</robot>
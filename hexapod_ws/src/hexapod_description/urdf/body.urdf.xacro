<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_body">

    <link name="base_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/frame.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.198 0.205 0.016"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>

      <inertial>
        <origin xyz="-0.00002 -0.00106 0.00800" rpy="0 0 0"/>
        <mass value="0.4864"/>
        <inertia ixx="1.763e-03" ixy="-5.177e-08" ixz="5.397e-10" iyy="1.708e-03" iyz="2.214e-09" izz="3.371e-03"/>
      </inertial>
    </link>

    <link name="top_cover_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/top-cover.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0.0125" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.00000 -0.00000 0.04655" rpy="0 0 0"/>
        <mass value="0.1846"/>
        <inertia ixx="1.510e-04" ixy="1.687e-10" ixz="4.441e-11" iyy="2.034e-04" iyz="-1.877e-10" izz="2.428e-04"/>
      </inertial>
    </link>

    <joint name="top_cover_joint" type="fixed">
      <parent link="base_link"/>
      <child link="top_cover_link"/>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
    </joint>

    <link name="bottom_cover_link">
      <visual>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/bottom-cover.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0.00054 0.00110 -0.01698" rpy="0 0 0"/>
        <mass value="0.4426"/>
        <inertia ixx="7.003e-04" ixy="-3.336e-06" ixz="-4.496e-06" iyy="1.982e-04" iyz="-2.872e-06" izz="7.458e-04"/>
      </inertial>
    </link>

    <joint name="bottom_cover_joint" type="fixed">
      <parent link="base_link"/>
      <child link="bottom_cover_link"/>
      <origin xyz="0 0 -0.003" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>